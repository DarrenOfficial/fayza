---
import Base from '../layouts/Base.astro';
import Ink from '../components/Ink.astro';
---

<Base title="lost" noindex>
  <section class="lost">
    <p class="mono">fig. 404</p>
    <h1 class="hand">this page<br />was torn out.<Ink kind="cross" class="x" delay={300} /></h1>
    <a class="hand" href="/">back to the wall →</a>
  </section>
</Base>

<style>
  .lost {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(48px, 12vw, 140px) var(--gutter);
  }
  h1 {
    position: relative;
    width: fit-content;
    font-size: calc(clamp(3rem, 10vw, 5.5rem) * var(--hand-scale));
    line-height: 0.9;
    margin: 12px 0 32px;
  }
  .x {
    width: 48px;
    height: 48px;
    right: -60px;
    top: 0;
  }
  a {
    color: var(--moss);
    font-size: calc(1.8rem * var(--hand-scale));
    text-decoration: none;
  }
</style>
