---
/** White scrollwork flourishes on the four corners of a photo. Parent must be position:relative. */
const paths = [
  'M6 70 C 6 30, 20 8, 60 6',
  'M60 6 C 70 6, 72 18, 62 20 C 54 22, 52 12, 58 12',
  'M6 70 C 18 70, 20 58, 12 56 C 6 55, 6 62, 10 62',
  'M18 40 C 28 22, 44 20, 46 30 C 47 38, 36 38, 38 32',
  'M30 54 C 38 46, 48 50, 44 56',
];
const corners = ['tl', 'tr', 'bl', 'br'];
---

{
  corners.map((c) => (
    <svg class:list={['scroll', c]} viewBox="0 0 74 74" aria-hidden="true">
      {paths.map((d) => <path d={d} />)}
    </svg>
  ))
}

<style>
  .scroll {
    position: absolute;
    z-index: 3;
    width: clamp(38px, 22%, 62px);
    aspect-ratio: 1;
    color: #fffdf6;
    filter: drop-shadow(0 0 0.6px rgba(50, 40, 25, 0.75)) drop-shadow(0 1px 1px rgba(50, 40, 25, 0.25));
    pointer-events: none;
  }
  .scroll path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .tl { top: -8px; left: -8px; }
  .tr { top: -8px; right: -8px; scale: -1 1; }
  .bl { bottom: -8px; left: -8px; scale: 1 -1; }
  .br { bottom: -8px; right: -8px; scale: -1 -1; }
</style>
