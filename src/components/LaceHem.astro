---
/** Scalloped lace edge hanging under the top bar. One 32px repeat tile, tiled by CSS. */
const tile =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' width='32' height='20' viewBox='0 0 32 20'>` +
      `<path d='M0 0H32V7Q24 20 16 7Q8 20 0 7Z' fill='#fdfaf2'/>` +
      `<path d='M0 7Q8 20 16 7Q24 20 32 7' fill='none' stroke='rgba(110,92,64,.28)' stroke-width='.7'/>` +
      `<circle cx='8' cy='9.5' r='2.3' fill='rgba(110,92,64,.42)'/><circle cx='24' cy='9.5' r='2.3' fill='rgba(110,92,64,.42)'/>` +
      `<circle cx='16' cy='3.5' r='1' fill='rgba(110,92,64,.38)'/><circle cx='0' cy='3.5' r='1' fill='rgba(110,92,64,.38)'/><circle cx='32' cy='3.5' r='1' fill='rgba(110,92,64,.38)'/>` +
      `</svg>`,
  );
---

<span class="hem" aria-hidden="true" style={`--tile:url("${tile}")`}></span>

<style>
  .hem {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 20px;
    background: var(--tile) repeat-x 0 0 / 32px 20px;
    filter: drop-shadow(0 2px 1.5px rgba(60, 44, 24, 0.16));
    pointer-events: none;
  }
</style>
