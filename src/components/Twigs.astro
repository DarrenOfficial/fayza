---
/**
 * Fine-pen branches growing out from two opposite corners of a photo
 * (deterministic per seed). Fixed aspect so they never stretch with the photo.
 * Parent must be position:relative.
 */
interface Props { seed?: number }
const { seed: s0 = 7 } = Astro.props;
let seed = s0 * 977 + 13;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

function sprig(roots: [number, number, number, number, number][]) {
  const paths: string[] = [];
  const buds: { x: number; y: number; a: number }[] = [];
  const branch = (x: number, y: number, a: number, len: number, depth: number) => {
    if (depth === 0 || len < 3) {
      if (rnd() > 0.5) buds.push({ x, y, a: (a * 180) / Math.PI });
      return;
    }
    const x2 = x + Math.cos(a) * len, y2 = y + Math.sin(a) * len;
    const bend = (rnd() - 0.5) * len * 0.5;
    const mx = (x + x2) / 2 + Math.cos(a + Math.PI / 2) * bend, my = (y + y2) / 2 + Math.sin(a + Math.PI / 2) * bend;
    paths.push(`M${x.toFixed(1)} ${y.toFixed(1)} Q${mx.toFixed(1)} ${my.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`);
    branch(x2, y2, a + (rnd() - 0.5) * 0.6, len * 0.78, depth - 1);
    if (rnd() > 0.4) branch(x2, y2, a + (rnd() > 0.5 ? 0.75 : -0.75), len * 0.5, depth - 2);
  };
  for (const [x, y, a, len, depth] of roots) branch(x, y, a, len, depth);
  return { paths, buds };
}
// 100×100 boxes; the photo corner sits at (40,60) bottom-left / (60,40) top-right.
const bl = sprig([
  [38, 58, -1.95, 19, 7], // climbs up, just outside the left edge
  [42, 62, 0.22, 18, 6], // runs right, just below the bottom edge
  [37, 63, 2.35, 13, 5], // out and away
]);
const tr = sprig([
  [62, 42, 1.2, 19, 7], // falls down, just outside the right edge
  [58, 38, -2.92, 18, 6], // runs left, just above the top edge
  [63, 37, -0.8, 13, 5],
]);
const parts = [
  { cls: 'bl', ...bl },
  { cls: 'tr', ...tr },
];
---

{
  parts.map((p) => (
    <svg class:list={['twigs', p.cls]} viewBox="0 0 100 100" aria-hidden="true">
      <g class="stems">
        {p.paths.map((d, i) => (
          <path d={d} pathLength="1" style={`--d:${i * 22}`} />
        ))}
      </g>
      <g class="buds">
        {p.buds.map((b) => (
          <ellipse cx={b.x.toFixed(1)} cy={b.y.toFixed(1)} rx="1.6" ry=".75" transform={`rotate(${b.a.toFixed(0)} ${b.x.toFixed(1)} ${b.y.toFixed(1)})`} />
        ))}
      </g>
    </svg>
  ))
}

<style>
  .twigs {
    position: absolute;
    width: clamp(150px, 60%, 230px);
    aspect-ratio: 1;
    color: #34352a;
    pointer-events: none;
    overflow: visible;
  }
  .bl {
    left: 0;
    bottom: 0;
    translate: -40% 40%;
  }
  .tr {
    right: 0;
    top: 0;
    translate: 40% -40%;
  }
  .stems path {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.55;
    stroke-linecap: round;
  }
  .buds ellipse {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.45;
  }
  @media (prefers-reduced-motion: no-preference) {
    .stems path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: ink-draw 1100ms var(--ease-in-out) forwards;
      animation-delay: calc(var(--d) * 1ms + 300ms);
    }
    .buds {
      opacity: 0;
      animation: bud-in 500ms var(--ease-out) 1400ms forwards;
    }
  }
  @keyframes bud-in {
    to {
      opacity: 1;
    }
  }
</style>
