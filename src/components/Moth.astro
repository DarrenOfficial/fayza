  <path d="M37 24 C 26 4, 4 2, 3 14 C 2 26, 18 30, 34 27 C 20 32, 8 44, 18 48 C 28 50, 34 38, 37 28 C 40 38, 46 50, 56 48 C 66 44, 54 32, 40 27 C 56 30, 72 26, 71 14 C 70 2, 48 4, 37 24 Z" fill="#f6f1e4" stroke="#5b5646" stroke-width=".8"></path>
  <path d="M14 14 C 20 16, 26 20, 32 24 M60 14 C 54 16, 48 20, 42 24 M12 40 C 20 36, 26 32, 33 29 M62 40 C 54 36, 48 32, 41 29" fill="none" stroke="#8a846f" stroke-width=".6"></path>
