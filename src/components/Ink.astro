---
/** Hand-drawn ink marks. Paths use pathLength=1 so they can "draw in". */
interface Props {
  kind: 'underline' | 'circle' | 'arrow' | 'star' | 'swirl' | 'bracket' | 'cross' | 'heart';
  class?: string;
  style?: string;
  delay?: number;
  draw?: boolean;
  color?: string;
}
const { kind, class: cls = '', style = '', delay = 0, draw = true, color, ...rest } = Astro.props;
const shapes: Record<Props['kind'], { vb: string; d: string[] }> = {
  underline: { vb: '0 0 200 20', d: ['M4 12 C 40 6, 80 15, 120 9 S 180 7, 196 11'] },
  circle: { vb: '0 0 200 90', d: ['M150 10 C 100 -2, 18 10, 8 42 C 0 74, 70 88, 128 80 C 186 72, 204 40, 176 20 C 160 9, 120 6, 96 8'] },
  arrow: { vb: '0 0 120 80', d: ['M6 10 C 30 60, 70 70, 108 58', 'M92 46 L 110 58 L 94 72'] },
  star: { vb: '0 0 60 60', d: ['M30 4 L 30 56', 'M6 30 L 54 30', 'M12 12 L 48 48', 'M48 12 L 12 48'] },
  swirl: { vb: '0 0 120 60', d: ['M4 40 C 20 4, 44 4, 40 30 C 36 54, 14 44, 30 26 C 48 6, 70 54, 90 30 C 100 18, 108 22, 116 14'] },
  bracket: { vb: '0 0 20 200', d: ['M16 4 C 6 6, 8 40, 8 96 C 8 150, 6 192, 16 196'] },
  cross: { vb: '0 0 40 40', d: ['M6 8 L 34 32', 'M32 6 L 8 34'] },
  heart: { vb: '0 0 60 54', d: ['M30 50 C 8 34, 2 22, 8 12 C 14 2, 26 4, 30 16 C 34 4, 46 2, 52 12 C 58 22, 52 34, 30 50'] },
};
const s = shapes[kind];
---

<svg
  {...rest}
  class:list={['ink', `ink-${kind}`, { draw }, cls]}
  viewBox={s.vb}
  preserveAspectRatio="none"
  aria-hidden="true"
  style={`--d:${delay};${color ? `color:${color};` : ''}${style}`}
>
  {s.d.map((d) => <path d={d} pathLength="1" />)}
</svg>
